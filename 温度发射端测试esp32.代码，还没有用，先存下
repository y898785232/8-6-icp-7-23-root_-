/*
 * ESP32-C3 温度传感器（适配 ICP 前端 door_ 协议）
 * 板子：ESP32-C3FH4
 */

#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WiFiManager.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <HardwareSerial.h>
#include <ArduinoJson.h>

// ========== ESP32-C3 可用引脚 ==========
#define ONE_WIRE_BUS  4     // DS18B20
#define LORA_RX       6     // 接 LoRa TX
#define LORA_TX       7     // 接 LoRa RX
#define LORA_M0       5
#define LORA_M1       10    // 不要用 8/9（启动脚）

const char* mqtt_server = "b7fea2bf.ala.asia-southeast1.emqxsl.com";
const uint16_t mqtt_port = 8883;
const char* mqtt_user   = "eps8266nn";
const char* mqtt_pass   = "yu155414";

HardwareSerial LoRaSerial(1);
WiFiClientSecure secureClient;
PubSubClient mqttClient(secureClient);
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

String deviceId, topicCmd, topicStatus;

const unsigned long SAMPLE_INTERVAL = 60000UL;
unsigned long lastSample = 0, convStart = 0;
bool convPending = false;
float latestTemp = 0.0;
bool sensorOk = false;

void setLoRaMode() {
  pinMode(LORA_M0, OUTPUT);
  pinMode(LORA_M1, OUTPUT);
  digitalWrite(LORA_M0, LOW);
  digitalWrite(LORA_M1, LOW);
  delay(50);
}

String makeDeviceId() {
  uint64_t mac = ESP.getEfuseMac();
  uint32_t id  = (uint32_t)(mac & 0xFFFFFF);
  char buf[16];
  sprintf(buf, "%06x", id);
  return String("door_") + String(buf);
}

void publishStatus(bool online) {
  if (!mqttClient.connected()) return;

  StaticJsonDocument<256> doc;
  doc["online"] = online;
  doc["sensor_ok"] = sensorOk;
  doc["unit"] = "°C";
  doc["id"] = deviceId;
  if (sensorOk) doc["temperature"] = latestTemp;
  else doc["temperature"] = nullptr;

  char payload[256];
  serializeJson(doc, payload);
  mqttClient.publish(topicStatus.c_str(), payload, true);
  Serial.printf("MQTT → %s : %s\n", topicStatus.c_str(), payload);
}

void sendLoRaData() {
  StaticJsonDocument<160> doc;
  doc["id"] = deviceId;
  doc["ok"] = sensorOk;
  doc["ts"] = millis() / 1000;
  if (sensorOk) doc["temp"] = latestTemp;
  else doc["temp"] = nullptr;

  char json[180];
  serializeJson(doc, json);
  LoRaSerial.println(json);
  Serial.printf("LoRa → %s\n", json);
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  String command;
  for (unsigned int i = 0; i < length; i++) command += (char)payload[i];
  command.trim();
  Serial.printf("收到指令: %s\n", command.c_str());
  if (command == "STATUS") {
    sendLoRaData();
    publishStatus(true);
  }
}

void finishConversion() {
  convPending = false;
  latestTemp = sensors.getTempCByIndex(0);
  sensorOk = (latestTemp > -55.0 && latestTemp < 125.0 && !isnan(latestTemp));

  if (sensorOk) Serial.printf("温度: %.2f °C\n", latestTemp);
  else Serial.println("DS18B20 读取失败");

  sendLoRaData();
  if (mqttClient.connected()) publishStatus(true);
}

void reconnectMQTT() {
  if (mqttClient.connected()) return;
  if (WiFi.status() != WL_CONNECTED) return;

  Serial.print("连接 MQTT...");
  if (mqttClient.connect(deviceId.c_str(), mqtt_user, mqtt_pass)) {
    Serial.println("成功");
    mqttClient.subscribe(topicCmd.c_str());
    publishStatus(true);
  } else {
    Serial.printf("失败, rc=%d\n", mqttClient.state());
  }
}

void setup() {
  Serial.begin(115200);
  delay(2000);
  Serial.println();
  Serial.println("ESP32-C3 温度传感器启动...");

  setLoRaMode();
  Serial.println("1 OK: LoRa pins");

  LoRaSerial.begin(9600, SERIAL_8N1, LORA_RX, LORA_TX);
  Serial.println("2 OK: LoRa serial");

  deviceId = makeDeviceId();
  topicCmd = "door/" + deviceId + "/cmd";
  topicStatus = "door/" + deviceId + "/status";
  Serial.println("3 OK: " + deviceId);
  Serial.println("   CMD: " + topicCmd);
  Serial.println("   STATUS: " + topicStatus);

  WiFiManager wifiManager;
  // wifiManager.resetSettings();  // 重新配网时打开这行
  Serial.println("4: 进入 WiFi 配网...");
  if (!wifiManager.autoConnect("TEMP_SENSOR_ESP32")) {
    Serial.println("WiFi 失败，重启");
    delay(2000);
    ESP.restart();
  }
  Serial.println("5 OK: WiFi " + WiFi.localIP().toString());

  secureClient.setInsecure();
  mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setCallback(mqttCallback);
  mqttClient.setBufferSize(512);
  reconnectMQTT();
  Serial.println("6 OK: MQTT init");

  sensors.begin();
  sensors.setResolution(12);
  sensors.setWaitForConversion(false);
  sensors.requestTemperatures();
  convStart = millis();
  convPending = true;
  lastSample = millis();
  Serial.println("7 OK: 启动完成");
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    if (!mqttClient.connected()) {
      static unsigned long lastTry = 0;
      if (millis() - lastTry > 5000) {
        lastTry = millis();
        reconnectMQTT();
      }
    } else {
      mqttClient.loop();
    }
  }

  unsigned long now = millis();

  if (convPending && (now - convStart >= 900)) {
    finishConversion();
  }

  if (!convPending && (now - lastSample >= SAMPLE_INTERVAL)) {
    lastSample = now;
    sensors.requestTemperatures();
    convStart = millis();
    convPending = true;
  }

  if (LoRaSerial.available()) {
    String cmd = LoRaSerial.readStringUntil('\n');
    cmd.trim();
    if (cmd.indexOf("STATUS") != -1) {
      sendLoRaData();
      if (mqttClient.connected()) publishStatus(true);
    }
  }

  delay(10);
}