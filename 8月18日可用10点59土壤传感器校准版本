/*
 * ESP8266 D1 Mini Soil Moisture Sensor - door_ protocol
 * 
 * Calibration (do once, saved to Flash):
 *   1. Upload, open Serial Monitor (115200 baud, NL line ending)
 *   2. Leave sensor in dry air, type: CAL_DRY
 *   3. Put sensor in water/wet soil, type: CAL_WET
 *   4. Type CAL_SHOW to verify
 *   5. Type CAL_RESET to clear calibration and restart
 */

#include <ESP8266WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WiFiManager.h>
#include <SoftwareSerial.h>
#include <ArduinoJson.h>
#include <EEPROM.h>

#define SOIL_PIN        A0
#define LORA_RX         D2
#define LORA_TX         D1
#define LORA_M0         D7
#define LORA_M1         D6

#define ADDR_DRY        0
#define ADDR_WET        4
#define ADDR_FLAG       8
#define CAL_FLAG_MAGIC  0xABCD

SoftwareSerial LoRaSerial(LORA_RX, LORA_TX);

const char* mqtt_server = "b7fea2bf.ala.asia-southeast1.emqxsl.com";
const uint16_t mqtt_port = 8883;
const char* mqtt_user = "eps8266nn";
const char* mqtt_pass = "yu155414";

WiFiClientSecure secureClient;
PubSubClient mqttClient(secureClient);

String deviceId;
String topicCmd;
String topicStatus;

const unsigned long SAMPLE_INTERVAL = 60000UL;
unsigned long lastSample = 0;

float latestMoisture = 0.0;
int latestRawAdc = 0;
bool sensorOk = false;

int soilDry = 850;
int soilWet = 50;

void feedWatchdog() {
#ifdef ESP8266
  ESP.wdtFeed();
#endif
}

void setLoRaMode() {
  pinMode(LORA_M0, OUTPUT);
  pinMode(LORA_M1, OUTPUT);
  digitalWrite(LORA_M0, LOW);
  digitalWrite(LORA_M1, LOW);
  delay(100);
}

String makeDeviceId() {
  return "door_" + String(ESP.getChipId(), HEX);
}

void loadCalibration() {
  EEPROM.begin(512);
  int flag;
  EEPROM.get(ADDR_FLAG, flag);
  if (flag == CAL_FLAG_MAGIC) {
    EEPROM.get(ADDR_DRY, soilDry);
    EEPROM.get(ADDR_WET, soilWet);
    Serial.print("Calibration loaded: dry=");
    Serial.print(soilDry);
    Serial.print(" wet=");
    Serial.println(soilWet);
  } else {
    Serial.println("Not calibrated. Send CAL_DRY and CAL_WET");
  }
}

void saveCalibration() {
  EEPROM.put(ADDR_DRY, soilDry);
  EEPROM.put(ADDR_WET, soilWet);
  int flag = CAL_FLAG_MAGIC;
  EEPROM.put(ADDR_FLAG, flag);
  EEPROM.commit();
  Serial.print("Calibration saved: dry=");
  Serial.print(soilDry);
  Serial.print(" wet=");
  Serial.println(soilWet);
}

// ========== 修复后的读取函数 ==========
void readSoilSensor() {
  long sum = 0;
  for (int i = 0; i < 5; i++) {
    sum += analogRead(SOIL_PIN);
    delay(5);
  }
  int raw = sum / 5;
  latestRawAdc = raw;
  sensorOk = (raw > 0 && raw < 1024);

  if (sensorOk) {
    // 修复：直接用 soilDry -> 0%, soilWet -> 100%，不再自动交换大小值
    float pct = map(raw, soilDry, soilWet, 0, 100);
    if (pct < 0) pct = 0;
    if (pct > 100) pct = 100;
    latestMoisture = pct;
    Serial.print("Soil raw=");
    Serial.print(raw);
    Serial.print(" -> ");
    Serial.print(pct, 1);
    Serial.println("%");
  } else {
    Serial.print("Soil sensor error raw=");
    Serial.println(raw);
  }
}

void publishStatus(bool online) {
  if (!mqttClient.connected()) return;
  StaticJsonDocument<256> doc;
  doc["online"] = online;
  doc["sensor_ok"] = sensorOk;
  doc["unit"] = "%";
  doc["raw_adc"] = latestRawAdc;
  doc["dry_cal"] = soilDry;
  doc["wet_cal"] = soilWet;
  if (sensorOk) doc["moisture"] = latestMoisture;
  else doc["moisture"] = nullptr;
  char payload[350];
  serializeJson(doc, payload);
  mqttClient.publish(topicStatus.c_str(), payload, true);
  Serial.print("-> MQTT: ");
  Serial.println(payload);
}

void sendLoRaData() {
  StaticJsonDocument<256> doc;
  doc["id"] = deviceId;
  doc["ok"] = sensorOk;
  doc["ts"] = millis() / 1000;
  doc["raw"] = latestRawAdc;
  if (sensorOk) doc["moisture"] = latestMoisture;
  else doc["moisture"] = nullptr;
  char json[250];
  serializeJson(doc, json);
  LoRaSerial.println(json);
  Serial.print("-> LoRa: ");
  Serial.println(json);
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  char buf[64];
  if (length >= sizeof(buf)) length = sizeof(buf) - 1;
  memcpy(buf, payload, length);
  buf[length] = '\0';
  String command = String(buf);
  command.trim();

  Serial.print("<- MQTT cmd: [");
  Serial.print(topic);
  Serial.print("] ");
  Serial.println(command);

  if (command == "STATUS") {
    readSoilSensor();
    sendLoRaData();
    publishStatus(true);
  }
}

void reconnectMQTT() {
  if (mqttClient.connected()) return;
  Serial.println("Connecting MQTT...");
  secureClient.stop();
  delay(100);
  secureClient.setInsecure();
  secureClient.setTimeout(10);
  mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setCallback(mqttCallback);

  Serial.print("clientId: ");
  Serial.println(deviceId);

  if (mqttClient.connect(deviceId.c_str(), mqtt_user, mqtt_pass)) {
    Serial.println("MQTT connected");
    mqttClient.subscribe(topicCmd.c_str());
    publishStatus(true);
  } else {
    Serial.print("MQTT failed, rc=");
    Serial.println(mqttClient.state());
  }
}

void checkWiFi() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi lost, reconnecting...");
    WiFi.reconnect();
    unsigned long start = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - start < 10000) {
      delay(100);
      feedWatchdog();
    }
    if (WiFi.status() == WL_CONNECTED) {
      Serial.println("WiFi reconnected");
    }
  }
}

void handleSerialCommand() {
  if (!Serial.available()) return;
  String cmd = Serial.readStringUntil('\n');
  cmd.trim();
  cmd.toUpperCase();

  if (cmd == "CAL_DRY") {
    readSoilSensor();
    soilDry = latestRawAdc;
    saveCalibration();
    Serial.print("CAL DRY saved: ");
    Serial.println(soilDry);
  } else if (cmd == "CAL_WET") {
    readSoilSensor();
    soilWet = latestRawAdc;
    saveCalibration();
    Serial.print("CAL WET saved: ");
    Serial.println(soilWet);
  } else if (cmd == "CAL_SHOW") {
    Serial.print("CAL: dry=");
    Serial.print(soilDry);
    Serial.print(" wet=");
    Serial.println(soilWet);
  } else if (cmd == "CAL_RESET") {
    EEPROM.put(ADDR_FLAG, 0);
    EEPROM.commit();
    Serial.println("CAL reset, restarting...");
    delay(500);
    ESP.restart();
  }
}

void setup() {
  Serial.begin(115200);
  delay(2000);
  Serial.println("==============================");
  Serial.println("ESP8266 Soil Moisture Sensor");
  Serial.println("==============================");

  loadCalibration();
  pinMode(SOIL_PIN, INPUT);
  LoRaSerial.begin(9600);
  Serial.println("LoRaSerial OK");
  setLoRaMode();
  Serial.println("LoRa mode OK");

  deviceId = makeDeviceId();
  topicCmd = "door/" + deviceId + "/cmd";
  topicStatus = "door/" + deviceId + "/status";
  Serial.print("DeviceID: ");
  Serial.println(deviceId);

  WiFi.disconnect(true);
  delay(100);
  WiFiManager wifiManager;
  wifiManager.setConfigPortalTimeout(300);
  bool wifiOk = wifiManager.autoConnect("SOIL_SENSOR_ESP8266", "12345678");
  if (!wifiOk) {
    Serial.println("Config failed, restart");
    ESP.restart();
  }
  Serial.print("WiFi OK, IP: ");
  Serial.println(WiFi.localIP().toString());

  WiFi.setSleepMode(WIFI_NONE_SLEEP);
  WiFi.setAutoReconnect(true);

  readSoilSensor();
  lastSample = millis();

  reconnectMQTT();
  Serial.println("MQTT init OK");

  sendLoRaData();
  publishStatus(true);

  Serial.println("Ready. Commands: CAL_DRY / CAL_WET / CAL_SHOW / CAL_RESET");
}

void loop() {
  feedWatchdog();
  handleSerialCommand();
  checkWiFi();

  if (WiFi.status() == WL_CONNECTED) {
    if (!mqttClient.connected()) {
      reconnectMQTT();
    }
    mqttClient.loop();
  }

  unsigned long now = millis();
  if (now - lastSample >= SAMPLE_INTERVAL) {
    lastSample = now;
    readSoilSensor();
    sendLoRaData();
    if (mqttClient.connected()) publishStatus(true);
  }

  if (LoRaSerial.available()) {
    String cmd = LoRaSerial.readStringUntil('\n');
    cmd.trim();
    if (cmd.indexOf("STATUS") != -1) {
      readSoilSensor();
      sendLoRaData();
    }
  }

  delay(10);
}
