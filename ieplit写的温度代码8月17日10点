/*
 * ESP32-C3FH4 温度传感器 - door_ 协议
 * 适配 ICP 前端 + Node 桥接
 *
 * 功能：
 * 1. DS18B20 温度采集
 * 2. Wi-Fi 连接
 * 3. MQTT TLS 通信
 * 4. LoRa 串口通信
 * 5. MQTT / LoRa 接收 STATUS 指令
 * 6. 看门狗自动复位
 * 7. Wi-Fi 断线自动重连
 * 8. Wi-Fi 超过 2 分钟未恢复时自动重启
 */

#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WiFiManager.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <HardwareSerial.h>
#include <ArduinoJson.h>

#include "esp_system.h"
#include "esp_task_wdt.h"
#include "esp_idf_version.h"

// ========== ESP32-C3 引脚定义 ==========

#define ONE_WIRE_BUS 4
#define LORA_RX 6
#define LORA_TX 7
#define LORA_M0 5
#define LORA_M1 10

// ========== MQTT 配置 ==========

// MQTT 服务器地址可以使用原来的地址
const char* mqtt_server = "b7fea2bf.ala.asia-southeast1.emqxsl.com";
const uint16_t mqtt_port = 8883;

// 请替换为你自己的 MQTT 账号和密码
const char* mqtt_user = "YOUR_MQTT_USERNAME";
const char* mqtt_pass = "YOUR_MQTT_PASSWORD";

// Wi-FiManager 配网热点密码
// 请至少使用 8 位密码
const char* wifi_config_password = "YOUR_CONFIG_PASSWORD";

// ========== 对象初始化 ==========

HardwareSerial LoRaSerial(1);

WiFiClientSecure secureClient;
PubSubClient mqttClient(secureClient);

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

// ========== 全局变量 ==========

String deviceId;
String topicCmd;
String topicStatus;

const unsigned long SAMPLE_INTERVAL = 60000UL;

// Wi-Fi 断开超过 2 分钟后自动重启
const unsigned long WIFI_RESTART_AFTER = 120000UL;

// 看门狗超时时间
const uint32_t WATCHDOG_TIMEOUT_SECONDS = 30;

unsigned long lastSample = 0;
unsigned long convStart = 0;
unsigned long lastWifiTry = 0;
unsigned long wifiLostAt = 0;

bool convPending = false;
float latestTemp = 0.0;
bool sensorOk = false;

// ========== 看门狗 ==========

void initWatchdog() {
  esp_err_t err;

#if ESP_IDF_VERSION_MAJOR >= 5

  // ESP32 Arduino Core 3.x / ESP-IDF 5.x
  esp_task_wdt_config_t config = {};

  config.timeout_ms = WATCHDOG_TIMEOUT_SECONDS * 1000;
  config.idle_core_mask = (1 << portNUM_PROCESSORS) - 1;
  config.trigger_panic = true;

  err = esp_task_wdt_init(&config);

#else

  // ESP32 Arduino Core 2.x / ESP-IDF 4.x
  err = esp_task_wdt_init(WATCHDOG_TIMEOUT_SECONDS, true);

#endif

  // 某些 Arduino Core 已经提前初始化了看门狗
  if (err != ESP_OK && err != ESP_ERR_INVALID_STATE) {
    Serial.printf(
      "看门狗初始化失败: %s\n",
      esp_err_to_name(err)
    );
  }

  // 将当前任务加入看门狗监控
  err = esp_task_wdt_add(NULL);

  if (err != ESP_OK && err != ESP_ERR_INVALID_STATE) {
    Serial.printf(
      "看门狗注册失败: %s\n",
      esp_err_to_name(err)
    );
  } else {
    Serial.printf(
      "看门狗已启用: %u 秒\n",
      WATCHDOG_TIMEOUT_SECONDS
    );
  }
}

void feedWatchdog() {
  esp_task_wdt_reset();
}

// ========== LoRa 初始化 ==========

void setLoRaMode() {
  pinMode(LORA_M0, OUTPUT);
  pinMode(LORA_M1, OUTPUT);

  // M0=LOW，M1=LOW：LoRa 普通透传模式
  digitalWrite(LORA_M0, LOW);
  digitalWrite(LORA_M1, LOW);

  delay(50);
}

// ========== 生成设备 ID ==========

String makeDeviceId() {
  uint64_t mac = ESP.getEfuseMac();

  // 使用 MAC 地址低 24 位作为设备编号
  uint32_t id = (uint32_t)(mac & 0xFFFFFF);

  char buf[16];
  sprintf(buf, "%06x", id);

  return String("door_") + String(buf);
}

// ========== 发布 MQTT 状态 ==========

void publishStatus(bool online) {
  if (!mqttClient.connected()) {
    return;
  }

  StaticJsonDocument<256> doc;

  doc["online"] = online;
  doc["sensor_ok"] = sensorOk;
  doc["unit"] = "°C";
  doc["id"] = deviceId;

  if (sensorOk) {
    doc["temperature"] = latestTemp;
  } else {
    doc["temperature"] = nullptr;
  }

  char payload[256];
  serializeJson(doc, payload);

  bool success = mqttClient.publish(
    topicStatus.c_str(),
    payload,
    true
  );

  if (success) {
    Serial.printf(
      "MQTT → %s : %s\n",
      topicStatus.c_str(),
      payload
    );
  } else {
    Serial.println("MQTT 状态发布失败");
  }
}

// ========== 发送 LoRa 数据 ==========

void sendLoRaData() {
  StaticJsonDocument<160> doc;

  doc["id"] = deviceId;
  doc["ok"] = sensorOk;

  // 这是设备启动后的运行秒数，不是现实时间
  doc["ts"] = millis() / 1000;

  if (sensorOk) {
    doc["temp"] = latestTemp;
  } else {
    doc["temp"] = nullptr;
  }

  char json[180];
  serializeJson(doc, json);

  LoRaSerial.println(json);

  Serial.printf(
    "LoRa → %s\n",
    json
  );
}

// ========== MQTT 消息回调 ==========

void mqttCallback(
  char* topic,
  byte* payload,
  unsigned int length
) {
  String command;

  for (unsigned int i = 0; i < length; i++) {
    command += (char)payload[i];
  }

  command.trim();

  Serial.printf(
    "收到 MQTT 指令: %s\n",
    command.c_str()
  );

  if (command == "STATUS") {
    sendLoRaData();
    publishStatus(true);
  }
}

// ========== 完成温度转换 ==========

void finishConversion() {
  convPending = false;

  latestTemp = sensors.getTempCByIndex(0);

  sensorOk =
    latestTemp > -55.0 &&
    latestTemp < 125.0 &&
    !isnan(latestTemp);

  if (sensorOk) {
    Serial.printf(
      "温度: %.2f °C\n",
      latestTemp
    );
  } else {
    Serial.println("DS18B20 读取失败");
  }

  sendLoRaData();

  if (mqttClient.connected()) {
    publishStatus(true);
  }
}

// ========== MQTT 重连 ==========

void reconnectMQTT() {
  if (mqttClient.connected()) {
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  Serial.println("准备重连 MQTT...");

  // 每次重连前重置 TLS 连接
  secureClient.stop();

  delay(100);

  /*
   * 当前使用 TLS 加密，但不校验服务器证书。
   * 正式生产环境建议配置 EMQX CA 证书，
   * 不要长期使用 setInsecure()。
   */
  secureClient.setInsecure();

  // 防止 TLS 连接长时间阻塞
  secureClient.setTimeout(10);

  // EMQX 云端需要使用域名，不能使用 IP
  mqttClient.setServer(
    mqtt_server,
    mqtt_port
  );

  Serial.printf(
    "连接 MQTT... heap=%u\n",
    ESP.getFreeHeap()
  );

  // 生成 MQTT clientId
  String cid =
    deviceId + "_" +
    String((uint32_t)millis() % 10000);

  Serial.println(
    "clientId: " + cid
  );

  bool connected = mqttClient.connect(
    cid.c_str(),
    mqtt_user,
    mqtt_pass
  );

  if (connected) {
    Serial.println("MQTT 连接成功");

    bool subscribed = mqttClient.subscribe(
      topicCmd.c_str()
    );

    if (subscribed) {
      Serial.printf(
        "已订阅: %s\n",
        topicCmd.c_str()
      );
    } else {
      Serial.println("MQTT 订阅失败");
    }

    publishStatus(true);
  } else {
    Serial.printf(
      "MQTT 连接失败, rc=%d wifi=%d heap=%u\n",
      mqttClient.state(),
      WiFi.status(),
      ESP.getFreeHeap()
    );
  }
}

// ========== 初始化 ==========

void setup() {
  // 降低 CPU 频率，减少功耗
  setCpuFrequencyMhz(80);

  Serial.begin(115200);

  delay(2000);

  Serial.println();
  Serial.println("==============================");
  Serial.println("ESP32-C3 温度传感器启动");
  Serial.println("==============================");

  // 初始化 LoRa 模式引脚
  setLoRaMode();

  Serial.println("1 OK: LoRa pins");

  // 初始化 LoRa 串口
  LoRaSerial.begin(
    9600,
    SERIAL_8N1,
    LORA_RX,
    LORA_TX
  );

  Serial.println("2 OK: LoRa serial");

  // 生成设备 ID
  deviceId = makeDeviceId();

  topicCmd =
    "door/" +
    deviceId +
    "/cmd";

  topicStatus =
    "door/" +
    deviceId +
    "/status";

  Serial.println(
    "3 OK: " + deviceId
  );

  Serial.println(
    "   CMD: " + topicCmd
  );

  Serial.println(
    "   STATUS: " + topicStatus
  );

  // Wi-FiManager 自动连接或进入配网模式
  WiFiManager wifiManager;

  // 需要清除旧 Wi-Fi 配置时，临时取消下面一行的注释
  // wifiManager.resetSettings();

  Serial.println("4: 进入 WiFi 配网...");

  if (!wifiManager.autoConnect(
        "TEMP_SENSOR_ESP32",
        wifi_config_password
      )) {
    Serial.println("WiFi 失败，准备重启");

    delay(2000);

    ESP.restart();
  }

  Serial.println(
    "5 OK: WiFi " +
    WiFi.localIP().toString()
  );

  // Wi-Fi 设置
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(true);
  WiFi.setTxPower(WIFI_POWER_11dBm);

  // MQTT 设置
  mqttClient.setCallback(mqttCallback);
  mqttClient.setBufferSize(1024);

  // 缩短网络阻塞时间
  mqttClient.setSocketTimeout(10);

  mqttClient.setKeepAlive(30);

  // 启动看门狗
  initWatchdog();

  // 第一次连接 MQTT
  reconnectMQTT();

  Serial.println("6 OK: MQTT init");

  // 初始化 DS18B20
  sensors.begin();

  sensors.setResolution(12);

  // 使用非阻塞温度转换
  sensors.setWaitForConversion(false);

  // 启动第一次温度转换
  sensors.requestTemperatures();

  convStart = millis();
  convPending = true;

  lastSample = millis();

  Serial.println("7 OK: 启动完成");
}

// ========== 主循环 ==========

void loop() {
  // 主循环正常运行时持续喂狗
  feedWatchdog();

  // ========== Wi-Fi 断线处理 ==========

  if (WiFi.status() != WL_CONNECTED) {
    // 第一次检测到断网时记录时间
    if (wifiLostAt == 0) {
      wifiLostAt = millis();

      Serial.println(
        "WiFi 已断开，开始计时恢复"
      );
    }

    // 每 10 秒尝试恢复一次
    if (millis() - lastWifiTry > 10000) {
      lastWifiTry = millis();

      Serial.println(
        "WiFi 断开，尝试重新连接..."
      );

      WiFi.disconnect();

      delay(100);

      WiFi.reconnect();
    }

    // Wi-Fi 超过 2 分钟没有恢复，自动重启
    if (millis() - wifiLostAt >= WIFI_RESTART_AFTER) {
      Serial.println(
        "WiFi 超过 2 分钟未恢复，自动重启"
      );

      Serial.flush();

      ESP.restart();
    }

    // Wi-Fi 断开期间也要喂狗
    feedWatchdog();

    delay(50);

    return;
  }

  // Wi-Fi 从断开状态恢复
  if (wifiLostAt != 0) {
    Serial.println("WiFi 已恢复");

    wifiLostAt = 0;
  }

  // ========== MQTT 处理 ==========

  if (!mqttClient.connected()) {
    static unsigned long lastMqttTry = 0;

    // 每 8 秒尝试一次 MQTT 重连
    if (millis() - lastMqttTry > 8000) {
      lastMqttTry = millis();

      reconnectMQTT();
    }
  } else {
    mqttClient.loop();
  }

  unsigned long now = millis();

  // ========== 完成温度转换 ==========

  if (
    convPending &&
    (now - convStart >= 900)
  ) {
    finishConversion();
  }

  // ========== 每 60 秒开始一次新的温度采集 ==========

  if (
    !convPending &&
    (now - lastSample >= SAMPLE_INTERVAL)
  ) {
    lastSample = now;

    sensors.requestTemperatures();

    convStart = millis();
    convPending = true;
  }

  // ========== 处理 LoRa 指令 ==========

  if (LoRaSerial.available()) {
    String cmd =
      LoRaSerial.readStringUntil('\n');

    cmd.trim();

    if (cmd.indexOf("STATUS") != -1) {
      sendLoRaData();

      if (mqttClient.connected()) {
        publishStatus(true);
      }
    }
  }

  // 稍微让出 CPU
  delay(10);
}