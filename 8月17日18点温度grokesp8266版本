/*
 * ESP8266 D1 Mini / NodeMCU 温度传感器 - door_ 协议（修复版）
 * 修复内容：
 *   1. 注册 MQTT 回调（原代码回调不生效）
 *   2. 修复 payload 越界读取（原 String((char*)payload) 可能越界）
 *   3. 修复 WiFiManager 配网冲突（去掉手动 softAP，改用 autoConnect）
 *   4. 修复首次温度转换未标记 pending（原代码首次读温延迟 60 秒）
 *   5. 修复 WiFi 休眠 API（ESP8266 专用）
 *   6. 增加 WiFi 断线主动重连
 */

#include <ESP8266WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WiFiManager.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <SoftwareSerial.h>
#include <ArduinoJson.h>

// ========== 引脚定义 ==========
#define ONE_WIRE_BUS    D5
#define LORA_RX         D2
#define LORA_TX         D1
#define LORA_M0         D7
#define LORA_M1         D6

SoftwareSerial LoRaSerial(LORA_RX, LORA_TX);

const char* mqtt_server = "b7fea2bf.ala.asia-southeast1.emqxsl.com";
const uint16_t mqtt_port = 8883;
const char* mqtt_user = "eps8266nn";
const char* mqtt_pass = "yu155414";

WiFiClientSecure secureClient;
PubSubClient mqttClient(secureClient);
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

String deviceId;
String topicCmd;
String topicStatus;

const unsigned long SAMPLE_INTERVAL = 60000UL;
unsigned long lastSample = 0;
unsigned long convStart = 0;
bool convPending = false;

float latestTemp = 0.0;
bool sensorOk = false;

// ========== 看门狗 ==========
void feedWatchdog() {
  #ifdef ESP8266
    ESP.wdtFeed();
  #endif
}

// ========== LoRa 初始化 ==========
void setLoRaMode() {
  pinMode(LORA_M0, OUTPUT);
  pinMode(LORA_M1, OUTPUT);
  digitalWrite(LORA_M0, LOW);
  digitalWrite(LORA_M1, LOW);
  delay(100);
}

// ========== 生成设备 ID ==========
String makeDeviceId() {
  return "door_" + String(ESP.getChipId(), HEX);
}

// ========== 数据上报 ==========
void publishStatus(bool online) {
  if (!mqttClient.connected()) return;
  StaticJsonDocument<192> doc;
  doc["online"] = online;
  doc["sensor_ok"] = sensorOk;
  doc["unit"] = "°C";
  if (sensorOk) doc["temperature"] = latestTemp;
  else doc["temperature"] = nullptr;
  char payload[256];
  size_t len = serializeJson(doc, payload);
  mqttClient.publish(topicStatus.c_str(), payload, true);
  Serial.printf("→ MQTT 上报: %s\n", payload);
}

void sendLoRaData() {
  StaticJsonDocument<128> doc;
  doc["id"] = deviceId;
  doc["ok"] = sensorOk;
  doc["ts"] = millis() / 1000;
  if (sensorOk) doc["temp"] = latestTemp;
  else doc["temp"] = nullptr;
  char json[160];
  serializeJson(doc, json);
  LoRaSerial.println(json);
  Serial.printf("→ LoRa 发送: %s\n", json);
}

// ========== MQTT 回调（修复 payload 越界） ==========
void mqttCallback(char* topic, byte* payload, unsigned int length) {
  // 原代码 String((char*)payload) 可能越界，因为 payload 不保证 \0 结尾
  char buf[64];
  if (length >= sizeof(buf)) length = sizeof(buf) - 1;
  memcpy(buf, payload, length);
  buf[length] = '\0';
  String command = String(buf);
  command.trim();

  Serial.printf("← MQTT 命令: [%s] %s\n", topic, command.c_str());

  if (command == "STATUS") {
    sendLoRaData();
    publishStatus(true);
  }
}

// ========== 完成温度转换 ==========
void finishConversion() {
  convPending = false;
  latestTemp = sensors.getTempCByIndex(0);
  sensorOk = (latestTemp > -55.0 && latestTemp < 125.0 && !isnan(latestTemp));
  if (sensorOk) Serial.printf("温度: %.2f °C\n", latestTemp);
  else Serial.println("DS18B20 读取失败");
  sendLoRaData();
  if (mqttClient.connected()) publishStatus(true);
}

// ========== MQTT 重连（修复：注册回调） ==========
void reconnectMQTT() {
  if (mqttClient.connected()) return;

  Serial.println("连接 MQTT...");

  secureClient.stop();
  delay(100);
  secureClient.setInsecure();
  secureClient.setTimeout(10);
  mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setCallback(mqttCallback);  // ← 修复 1：注册回调！

  Serial.printf("clientId: %s\n", deviceId.c_str());

  if (mqttClient.connect(deviceId.c_str(), mqtt_user, mqtt_pass)) {
    Serial.println("MQTT 连接成功");
    mqttClient.subscribe(topicCmd.c_str());
    publishStatus(true);
  } else {
    Serial.printf("MQTT 连接失败, rc=%d\n", mqttClient.state());
  }
}

// ========== WiFi 主动重连 ==========
void checkWiFi() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi 断开，尝试重连...");
    WiFi.reconnect();
    unsigned long start = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - start < 10000) {
      delay(100);
      feedWatchdog();
    }
    if (WiFi.status() == WL_CONNECTED) {
      Serial.println("WiFi 重连成功");
    }
  }
}

void setup() {
  Serial.begin(115200);
  delay(2000);

  Serial.println();
  Serial.println("==============================");
  Serial.println("ESP8266 D1 Mini 温度传感器启动");
  Serial.println("==============================");

  LoRaSerial.begin(9600);
  Serial.println("LoRaSerial OK");

  setLoRaMode();
  Serial.println("LoRa 模式 OK");

  deviceId = makeDeviceId();
  topicCmd = "door/" + deviceId + "/cmd";
  topicStatus = "door/" + deviceId + "/status";
  Serial.println("设备ID: " + deviceId);

  // ==================== WiFi 配网（修复版） ====================
  WiFi.disconnect(true);
  delay(100);

  WiFiManager wifiManager;
  wifiManager.setConfigPortalTimeout(300);  // 5 分钟超时，防止永久阻塞
  // 去掉手动 softAP，让 WiFiManager 自己管理
  bool wifiOk = wifiManager.autoConnect("TEMP_SENSOR_ESP8266", "12345678");
  if (!wifiOk) {
    Serial.println("配网失败，自动重启");
    ESP.restart();
  }

  Serial.println("WiFi 配网成功，IP: " + WiFi.localIP().toString());

  // ESP8266 专用休眠设置
  WiFi.setSleepMode(WIFI_NONE_SLEEP);
  WiFi.setAutoReconnect(true);

  reconnectMQTT();
  Serial.println("MQTT init OK");

  sensors.begin();
  sensors.setResolution(12);
  sensors.setWaitForConversion(false);
  sensors.requestTemperatures();
  convStart = millis();
  lastSample = millis();
  convPending = true;  // ← 修复 2：标记转换中，确保 900ms 后就能读到首次温度

  Serial.println("启动完成！");
}

void loop() {
  feedWatchdog();

  // 修复 3：增加 WiFi 主动重连
  checkWiFi();

  if (WiFi.status() == WL_CONNECTED) {
    if (!mqttClient.connected()) {
      reconnectMQTT();
    }
    mqttClient.loop();
  }

  unsigned long now = millis();

  // 完成温度转换
  if (convPending && now - convStart >= 900) {
    finishConversion();
  }

  // 启动新一轮采样
  if (!convPending && now - lastSample >= SAMPLE_INTERVAL) {
    lastSample = now;
    sensors.requestTemperatures();
    convStart = millis();
    convPending = true;
  }

  // LoRa 命令处理
  if (LoRaSerial.available()) {
    String cmd = LoRaSerial.readStringUntil('\n');
    cmd.trim();
    if (cmd.indexOf("STATUS") != -1) {
      sendLoRaData();
    }
  }

  delay(10);
}
