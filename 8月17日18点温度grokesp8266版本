/*
 * ESP8266 D1 Mini 温度传感器 - door_ 协议（稳定版）
 * 修复：去掉 wifi_config_password（你现在用手动 WiFi）
 */

#include <ESP8266WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WiFiManager.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <SoftwareSerial.h>
#include <ArduinoJson.h>

#define ONE_WIRE_BUS    D5
#define LORA_RX         D2
#define LORA_TX         D1
#define LORA_M0         D7
#define LORA_M1         D6

SoftwareSerial LoRaSerial(LORA_RX, LORA_TX);

const char* mqtt_server = "b7fea2bf.ala.asia-southeast1.emqxsl.com";
const uint16_t mqtt_port = 8883;
const char* mqtt_user = "eps8266nn";
const char* mqtt_pass = "yu155414";

WiFiClientSecure secureClient;
PubSubClient mqttClient(secureClient);
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

String deviceId;
String topicCmd;
String topicStatus;

const unsigned long SAMPLE_INTERVAL = 60000UL;
unsigned long lastSample = 0;
unsigned long convStart = 0;
bool convPending = false;

float latestTemp = 0.0;
bool sensorOk = false;

void setLoRaMode() {
  pinMode(LORA_M0, OUTPUT);
  pinMode(LORA_M1, OUTPUT);
  digitalWrite(LORA_M0, LOW);
  digitalWrite(LORA_M1, LOW);
  delay(100);
}

void publishStatus(bool online) {
  if (!mqttClient.connected()) return;

  StaticJsonDocument<192> doc;
  doc["online"] = online;
  doc["sensor_ok"] = sensorOk;
  doc["unit"] = "°C";

  if (sensorOk) {
    doc["temperature"] = latestTemp;
  } else {
    doc["temperature"] = nullptr;
  }

  char payload[256];
  serializeJson(doc, payload);
  mqttClient.publish(topicStatus.c_str(), payload, true);
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  String command = String((char*)payload).substring(0, length);
  if (command == "STATUS") {
    sendLoRaData();
    publishStatus(true);
  }
}

void sendLoRaData() {
  StaticJsonDocument<128> doc;
  doc["id"] = deviceId;
  doc["ok"] = sensorOk;
  doc["ts"] = millis() / 1000;

  if (sensorOk) {
    doc["temp"] = latestTemp;
  } else {
    doc["temp"] = nullptr;
  }

  char json[160];
  serializeJson(doc, json);
  LoRaSerial.println(json);
  Serial.printf("→ LoRa 发送: %s\n", json);
}

void finishConversion() {
  convPending = false;
  latestTemp = sensors.getTempCByIndex(0);

  sensorOk = (latestTemp > -55.0 && latestTemp < 125.0 && !isnan(latestTemp));

  if (sensorOk) {
    Serial.printf("温度: %.2f °C\n", latestTemp);
  } else {
    Serial.println("DS18B20 读取失败");
  }

  sendLoRaData();
  if (mqttClient.connected()) publishStatus(true);
}

void reconnectMQTT() {
  if (mqttClient.connected()) return;

  Serial.println("连接 MQTT...");

  secureClient.stop();
  delay(100);
  secureClient.setInsecure();
  secureClient.setTimeout(10);
  mqttClient.setServer(mqtt_server, mqtt_port);

  Serial.printf("clientId: %s\n", deviceId.c_str());

  if (mqttClient.connect(deviceId.c_str(), mqtt_user, mqtt_pass)) {
    Serial.println("MQTT 连接成功");
    mqttClient.subscribe(topicCmd.c_str());
    publishStatus(true);
  } else {
    Serial.printf("MQTT 连接失败, rc=%d\n", mqttClient.state());
  }
}

void setup() {
  Serial.begin(115200);
  LoRaSerial.begin(9600);

  pinMode(LORA_M0, OUTPUT);
  pinMode(LORA_M1, OUTPUT);
  setLoRaMode();

  deviceId = "door_" + String(ESP.getChipId(), HEX);
  topicCmd = "door/" + deviceId + "/cmd";
  topicStatus = "door/" + deviceId + "/status";

  Serial.println("Device ID: " + deviceId);

  // ==================== 配网（手动 WiFi）===================
  WiFi.disconnect(true);
  WiFi.mode(WIFI_MODE_AP);
  delay(1000);

  WiFi.softAP("TEMP_SENSOR_ESP8266", "12345678");   // 配网密码（随便填，配完就改）

  Serial.println("AP 已启动！IP: 192.168.4.1");

  WiFiManager wifiManager;
  bool wifiOk = wifiManager.startConfigPortal("TEMP_SENSOR_ESP8266");
  if (!wifiOk) {
    Serial.println("配网失败，自动重启");
    ESP.restart();
  }

  Serial.println("5 OK: WiFi 配网成功");

  // ==================== 配网成功后的设置 ====================
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(true);

  // MQTT 设置
  reconnectMQTT();
  Serial.println("6 OK: MQTT init");

  sensors.begin();
  sensors.setResolution(12);
  sensors.setWaitForConversion(false);
  sensors.requestTemperatures();
  convStart = millis();
  lastSample = millis();

  Serial.println("启动完成！");
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    if (!mqttClient.connected()) {
      reconnectMQTT();
    }
    mqttClient.loop();
  }

  unsigned long now = millis();

  if (convPending && now - convStart >= 900) {
    finishConversion();
  }

  if (!convPending && now - lastSample >= SAMPLE_INTERVAL) {
    lastSample = now;
    sensors.requestTemperatures();
    convStart = millis();
    convPending = true;
  }

  if (LoRaSerial.available()) {
    String cmd = LoRaSerial.readStringUntil('\n');
    cmd.trim();
    if (cmd.indexOf("STATUS") != -1) {
      sendLoRaData();
    }
  }

  delay(10);
}