<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>智能控制中心</title>
<script src="https://unpkg.com/mqtt@5.3.4/dist/mqtt.min.js"></script>
<style>
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f4f6f9;margin:0;padding:15px;display:flex;flex-direction:column;align-items:center;box-sizing:border-box}
.container{max-width:480px;width:100%;background:#fff;padding:20px;border-radius:20px;box-shadow:0 8px 24px rgba(0,0,0,.05);box-sizing:border-box}
h2{text-align:center;color:#1a1a1a;margin:5px 0 20px;font-size:22px}
.grid-status{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:20px}
.status-item{background:#f8f9fa;border-radius:12px;padding:12px;display:flex;flex-direction:column;align-items:center;border:1px solid #edf0f2}
.status-label{font-size:12px;color:#8e8e93;margin-bottom:6px}
.badge{font-size:14px;font-weight:bold;padding:5px 12px;border-radius:20px;width:80%;text-align:center}
.bg-online{background:#34c759;color:#fff}.bg-offline{background:#ff3b30;color:#fff}
.bg-warning{background:#ffcc00;color:#1c1c1e}.bg-waiting{background:#8e8e93;color:#fff}
.bg-dark{background:#5856d6;color:#fff}.bg-bright{background:#ff9500;color:#fff}
.card{border:1px solid #edf0f2;border-radius:16px;padding:18px;margin-bottom:15px}
.card-title{font-weight:600;font-size:15px;margin-bottom:14px}
.btn{display:block;width:100%;padding:14px;font-size:16px;font-weight:600;border:none;border-radius:12px;cursor:pointer;text-align:center;box-sizing:border-box}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btn-primary{background:#007aff;color:#fff}.btn-success{background:#34c759;color:#fff}
.btn-danger{background:#ff3b30;color:#fff}.btn-gray{background:#8e8e93;color:#fff}
.btn-row{display:flex;gap:10px}.btn-row .btn{flex:1}
.timer-inputs{display:flex;gap:10px;width:100%;margin-bottom:14px}
.time-box{flex:1;display:flex;flex-direction:column;gap:5px}.time-box span{font-size:12px;color:#8e8e93}
input[type=time],input[type=text],input[type=email],input[type=password],input[type=number],textarea,select{
width:100%;padding:10px;border:1px solid #d1d1d6;border-radius:8px;font-size:14px;background:#f8f9fa;box-sizing:border-box;margin-bottom:10px}
textarea{min-height:70px;resize:vertical}
input[type=checkbox]{width:18px;height:18px;margin-right:6px}
#mqtt-banner{font-size:12px;text-align:center;padding:6px 0;margin-bottom:14px;color:#8e8e93}
.auth-bar{display:flex;align-items:center;justify-content:space-between;background:#f6f0ff;border-radius:10px;padding:8px 12px;margin-bottom:14px;font-size:13px}
.auth-bar button{font-size:12px;padding:4px 10px;border:1px solid #5856d6;border-radius:8px;background:#fff;color:#5856d6;cursor:pointer;margin-left:6px}
.device-list-item{display:flex;align-items:center;background:#f8f9fa;border:1px solid #edf0f2;border-radius:14px;padding:14px;margin-bottom:10px;gap:10px}
.device-list-item .device-icon{font-size:28px;flex-shrink:0}
.device-list-item .device-info{flex:1;min-width:0}
.device-list-item .device-name{font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.device-list-item .device-id{font-size:12px;color:#8e8e93;margin-top:2px;word-break:break-all}
.device-list-item .device-actions{display:flex;gap:6px;flex-shrink:0}
.device-list-item .btn-ctrl{font-size:13px;padding:7px 14px;background:#007aff;color:#fff;border:none;border-radius:8px;cursor:pointer;font-weight:600}
.device-list-item .btn-edit{font-size:13px;padding:7px 10px;background:#fff;color:#8e8e93;border:1px solid #d1d1d6;border-radius:8px;cursor:pointer}
.add-device-btn{display:flex;align-items:center;justify-content:center;gap:8px;background:#f0f4ff;border:1.5px dashed #007aff;border-radius:14px;padding:14px;color:#007aff;font-size:15px;font-weight:600;cursor:pointer;margin-top:4px}
.device-header{display:flex;align-items:center;background:#f0f4ff;border-radius:10px;padding:8px 12px;margin-bottom:10px;gap:8px}
.device-header .back-btn{font-size:13px;padding:4px 10px;border:1px solid #007aff;border-radius:8px;background:#fff;color:#007aff;cursor:pointer}
.type-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:14px}
.type-btn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:12px 8px;border:2px solid #edf0f2;border-radius:12px;background:#f8f9fa;cursor:pointer}
.type-btn.selected{border-color:#007aff;background:#e8f2ff}
.type-btn .type-icon{font-size:24px}.type-btn .type-label{font-size:12px;font-weight:600}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;z-index:999}
.modal-box{background:#fff;border-radius:20px;padding:28px 24px;width:320px;box-shadow:0 12px 40px rgba(0,0,0,.2);max-height:90vh;overflow-y:auto}
.modal-box h3{margin:0 0 8px;font-size:18px}.modal-box p{margin:0 0 12px;font-size:13px;color:#8e8e93}
.modal-btn-row{display:flex;gap:10px}.modal-btn-row .btn{flex:1;padding:12px;font-size:15px}
.section-label{font-size:12px;color:#8e8e93;margin-bottom:8px;font-weight:500}
.tabs{display:flex;margin-bottom:16px;border-radius:12px;overflow:hidden;border:1px solid #edf0f2}
.tab{flex:1;text-align:center;padding:12px;background:#f8f9fa;cursor:pointer;font-weight:600;font-size:14px}
.tab.active{background:#007aff;color:#fff}
.hidden{display:none!important}
.nav{display:flex;gap:8px;margin-bottom:14px}
.nav button{flex:1;padding:10px;font-size:13px;border-radius:10px;border:1px solid #edf0f2;background:#f8f9fa;cursor:pointer;font-weight:600}
.nav button.active{background:#007aff;color:#fff;border-color:#007aff}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:#1c1c1e;color:#fff;padding:10px 20px;border-radius:20px;font-size:14px;transition:transform .3s;z-index:9999}
.toast.show{transform:translateX(-50%) translateY(0)}
.temp-big{font-size:42px;font-weight:700;color:#007aff;text-align:center;padding:20px 0}
</style>
</head>
<body>

<div class="modal-overlay" id="modal-overlay" style="display:none">
  <div class="modal-box">
    <div id="modal-bind-section" style="display:none">
      <h3>绑定新设备</h3>
      <p>支持 <strong>ESP_XXXXXX</strong> 或 <strong>door_xxxxxx</strong></p>
      <input type="text" id="modal-device-id" placeholder="例如：ESP_1A2B3C 或 door_772ef9" maxlength="32">
      <input type="text" id="modal-device-name" placeholder="设备名称（如：鸡舍主棚）" maxlength="20">
      <div class="section-label">选择设备类型</div>
      <div class="type-grid" id="type-grid">
        <div class="type-btn selected" data-type="jishe" onclick="selectType('jishe')"><span class="type-icon">🐔</span><span class="type-label">鸡舍</span></div>
        <div class="type-btn" data-type="shuibeng" onclick="selectType('shuibeng')"><span class="type-icon">💧</span><span class="type-label">水泵</span></div>
        <div class="type-btn" data-type="juanlianmen" onclick="selectType('juanlianmen')"><span class="type-icon">🚪</span><span class="type-label">卷帘门</span></div>
        <div class="type-btn" data-type="shuangdeng" onclick="selectType('shuangdeng')"><span class="type-icon">💡</span><span class="type-label">双灯+水泵</span></div>
        <div class="type-btn" data-type="tempsensor" onclick="selectType('tempsensor')"><span class="type-icon">🌡️</span><span class="type-label">温度传感器</span></div>
        <div class="type-btn" data-type="other" onclick="selectType('other')"><span class="type-icon">📡</span><span class="type-label">其他</span></div>
      </div>
      <div class="modal-btn-row">
        <button class="btn btn-gray" id="modal-cancel-btn" onclick="cancelBind()" style="display:none">取消</button>
        <button class="btn btn-primary" onclick="bindDevice()">确认绑定</button>
      </div>
    </div>
    <div id="modal-rename-section" style="display:none">
      <h3>编辑设备</h3>
      <input type="text" id="modal-rename-input" placeholder="设备名称" maxlength="20">
      <div class="section-label">设备类型</div>
      <div class="type-grid" id="type-grid-rename">
        <div class="type-btn" data-type="jishe" onclick="selectTypeRename('jishe')"><span class="type-icon">🐔</span><span class="type-label">鸡舍</span></div>
        <div class="type-btn" data-type="shuibeng" onclick="selectTypeRename('shuibeng')"><span class="type-icon">💧</span><span class="type-label">水泵</span></div>
        <div class="type-btn" data-type="juanlianmen" onclick="selectTypeRename('juanlianmen')"><span class="type-icon">🚪</span><span class="type-label">卷帘门</span></div>
        <div class="type-btn" data-type="shuangdeng" onclick="selectTypeRename('shuangdeng')"><span class="type-icon">💡</span><span class="type-label">双灯+水泵</span></div>
        <div class="type-btn" data-type="tempsensor" onclick="selectTypeRename('tempsensor')"><span class="type-icon">🌡️</span><span class="type-label">温度传感器</span></div>
        <div class="type-btn" data-type="other" onclick="selectTypeRename('other')"><span class="type-icon">📡</span><span class="type-label">其他</span></div>
      </div>
      <div class="modal-btn-row" style="margin-top:14px">
        <button class="btn btn-gray" onclick="cancelRename()">取消</button>
        <button class="btn btn-primary" onclick="confirmRename()">确认</button>
      </div>
    </div>
  </div>
</div>

<div class="container">
  <h2>🏠 智能控制中心</h2>

  <div id="view-auth">
    <div class="tabs">
      <div class="tab active" id="tab-login" onclick="switchAuthTab('login')">登录</div>
      <div class="tab" id="tab-register" onclick="switchAuthTab('register')">注册</div>
    </div>
    <div id="panel-login">
      <input type="email" id="login-email" placeholder="邮箱">
      <input type="password" id="login-password" placeholder="密码">
      <button class="btn btn-primary" onclick="emailLogin()">邮箱登录</button>
      <div style="text-align:center;margin:16px 0;color:#8e8e93;font-size:13px">或</div>
      <button class="btn btn-success" onclick="iiLogin()">🖐️ Internet Identity 登录</button>
    </div>
    <div id="panel-register" class="hidden">
      <input type="email" id="reg-email" placeholder="邮箱">
      <input type="password" id="reg-password" placeholder="密码（至少6位）">
      <input type="password" id="reg-password2" placeholder="确认密码">
      <button class="btn btn-primary" onclick="emailRegister()">注册账号</button>
      <div style="text-align:center;margin:16px 0;color:#8e8e93;font-size:13px">或</div>
      <button class="btn btn-success" onclick="iiLogin()">🖐️ 使用 Internet Identity 注册/登录</button>
    </div>
  </div>

  <div id="view-main" class="hidden">
    <div class="auth-bar">
      <span id="auth-status">已登录</span>
      <div>
        <button onclick="showAccountSecurity()">账号安全</button>
        <button onclick="logout()">退出</button>
      </div>
    </div>

    <div class="nav" id="main-nav">
      <button class="active" onclick="switchMainTab('devices')">设备</button>
      <button onclick="switchMainTab('pages')">页面</button>
      <button onclick="switchMainTab('rules')">规则</button>
    </div>

    <div id="view-list">
      <div style="font-size:13px;color:#8e8e93;margin-bottom:10px">选择要控制的设备</div>
      <div id="device-list-container"></div>
      <div class="add-device-btn" onclick="showBindForm()"><span>＋</span><span>绑定新设备</span></div>
    </div>

    <div id="view-control" class="hidden">
      <div class="device-header">
        <button class="back-btn" onclick="backToList()">← 返回</button>
        <span class="cur-device-name" id="cur-device-name">--</span>
        <span class="cur-device-id" id="cur-device-id">--</span>
      </div>
      <div id="mqtt-banner">正在连接云端服务器...</div>
      <div id="status-grid" class="grid-status"></div>
      <div id="device-panels"></div>
    </div>

    <div id="view-pages" class="hidden">
      <div id="page-list-container"></div>
      <div class="card" id="page-create-card">
        <div class="card-title">创建页面</div>
        <input type="text" id="new-page-device" placeholder="关联设备ID，如 ESP_1A2B3C 或 door_772ef9">
        <input type="text" id="new-page-title" placeholder="页面标题，如：鸡舍">
        <button class="btn btn-primary" onclick="createPage()">创建页面</button>
      </div>
      <div id="page-detail" class="hidden">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
          <button class="btn btn-gray" style="width:auto;padding:8px 12px;font-size:13px" onclick="backPageList()">← 返回</button>
          <span id="cur-page-title" style="font-weight:600"></span>
        </div>
        <div id="component-list-container"></div>
        <div class="card">
          <div class="card-title">添加控件</div>
          <select id="new-comp-type">
            <option value="switch">开关 switch</option>
            <option value="button">按钮 button</option>
            <option value="slider">滑块 slider</option>
            <option value="number">数值 number</option>
            <option value="text">文本 text</option>
            <option value="gauge">仪表 gauge</option>
            <option value="chart">图表 chart</option>
            <option value="camera">摄像头 camera</option>
          </select>
          <input type="text" id="new-comp-title" placeholder="控件名称，如：照明灯">
          <textarea id="new-comp-config" placeholder='配置JSON，如 {"topic":"door/door_xxx/status"}'></textarea>
          <input type="number" id="new-comp-sort" value="1" placeholder="排序号">
          <button class="btn btn-primary" onclick="createComponent()">添加控件</button>
        </div>
      </div>
    </div>

    <div id="view-rules" class="hidden">
      <div id="rule-list-container"></div>
      <div class="card">
        <div class="card-title">创建自动化规则</div>
        <input type="text" id="new-rule-device" placeholder="设备ID，如 door_772ef9">
        <input type="text" id="new-rule-trigger" placeholder="触发源，如 temperature">
        <input type="text" id="new-rule-condition" placeholder='条件JSON，如 {"op":">","value":30}'>
        <input type="text" id="new-rule-action" placeholder='动作JSON，如 {"cmd":"PUMP_ON"}'>
        <input type="number" id="new-rule-priority" value="10" placeholder="优先级">
        <label style="display:flex;align-items:center;font-size:14px;margin-bottom:10px">
          <input type="checkbox" id="new-rule-enable" checked> 启用规则
        </label>
        <button class="btn btn-primary" onclick="createRule()">创建规则</button>
      </div>
    </div>

    <div id="view-account" class="hidden">
      <div class="card"><div class="card-title">账号信息</div><div id="account-info" style="font-size:14px;line-height:1.8"></div></div>
      <div class="card"><div class="card-title">绑定 Internet Identity</div>
        <p style="font-size:13px;color:#8e8e93;margin-bottom:12px">绑定后可使用指纹/面容快速登录</p>
        <button class="btn btn-primary" onclick="bindII()">绑定 Internet Identity</button>
      </div>
      <div class="card"><div class="card-title">设置/修改密码</div>
        <input type="password" id="new-password" placeholder="新密码">
        <input type="password" id="new-password2" placeholder="确认新密码">
        <button class="btn btn-primary" onclick="setNewPassword()">保存密码</button>
      </div>
      <div class="card"><div class="card-title">绑定邮箱（II用户补充）</div>
        <input type="email" id="bind-email" placeholder="邮箱">
        <input type="password" id="bind-email-pwd" placeholder="设置密码">
        <button class="btn btn-primary" onclick="doBindEmail()">绑定邮箱</button>
      </div>
      <button class="btn btn-gray" onclick="backFromAccount()">返回</button>
    </div>
  </div>
</div>
<div class="toast" id="toast"></div>

<script type="module">
import { AuthClient } from "https://esm.sh/@dfinity/auth-client@3";
import { HttpAgent, Actor } from "https://esm.sh/@dfinity/agent@3";

const BACKEND_CANISTER_ID = "qitoc-aiaaa-aaaao-bbcvq-cai";
const II_URL = "https://identity.ic0.app";
const MQTT_HOST = "wss://b7fea2bf.ala.asia-southeast1.emqxsl.com:8084/mqtt";
const OFFLINE_MS = 360000;

const idlFactory = ({ IDL }) => {
  const User = IDL.Record({
    id: IDL.Nat, username: IDL.Opt(IDL.Text), email: IDL.Opt(IDL.Text), phone: IDL.Opt(IDL.Text),
    passwordHash: IDL.Opt(IDL.Text),
    methods: IDL.Vec(IDL.Variant({ InternetIdentity: IDL.Principal, Email: IDL.Text, Phone: IDL.Text, WeChat: IDL.Text })),
    createdAt: IDL.Int, updatedAt: IDL.Int
  });
  const AuthResult = IDL.Variant({ ok: IDL.Record({ user: User, sessionId: IDL.Opt(IDL.Text) }), err: IDL.Text });
  const OpResult = IDL.Variant({ ok: IDL.Text, err: IDL.Text });
  const Page = IDL.Record({ id: IDL.Nat, userId: IDL.Nat, deviceId: IDL.Text, title: IDL.Text, createdAt: IDL.Int });
  const Component = IDL.Record({ id: IDL.Nat, pageId: IDL.Nat, componentType: IDL.Text, title: IDL.Text, config: IDL.Text, sort: IDL.Nat, createdAt: IDL.Int });
  const Rule = IDL.Record({ id: IDL.Nat, deviceId: IDL.Text, enable: IDL.Bool, trigger: IDL.Text, condition: IDL.Text, action: IDL.Text, priority: IDL.Nat, createdAt: IDL.Int });
  return IDL.Service({
    registerWithEmail: IDL.Func([IDL.Text, IDL.Text], [AuthResult], []),
    loginWithEmail: IDL.Func([IDL.Text, IDL.Text], [AuthResult], []),
    getOrCreateUserByII: IDL.Func([], [AuthResult], []),
    bindInternetIdentity: IDL.Func([IDL.Opt(IDL.Text)], [OpResult], []),
    bindEmail: IDL.Func([IDL.Text, IDL.Text, IDL.Opt(IDL.Text)], [OpResult], []),
    setPassword: IDL.Func([IDL.Text, IDL.Opt(IDL.Text)], [OpResult], []),
    updateProfile: IDL.Func([IDL.Opt(IDL.Text), IDL.Opt(IDL.Text), IDL.Opt(IDL.Text)], [OpResult], []),
    getMyProfile: IDL.Func([IDL.Opt(IDL.Text)], [IDL.Variant({ ok: User, err: IDL.Text })], ["query"]),
    bindDevice: IDL.Func([IDL.Text, IDL.Opt(IDL.Text)], [OpResult], []),
    unbindDevice: IDL.Func([IDL.Text, IDL.Opt(IDL.Text)], [OpResult], []),
    myDevices: IDL.Func([IDL.Opt(IDL.Text)], [IDL.Vec(IDL.Text)], ["query"]),
    isDeviceBound: IDL.Func([IDL.Text], [IDL.Bool], ["query"]),
    createPage: IDL.Func([IDL.Text, IDL.Text, IDL.Opt(IDL.Text)], [IDL.Variant({ ok: Page, err: IDL.Text })], []),
    updatePage: IDL.Func([IDL.Nat, IDL.Text, IDL.Opt(IDL.Text)], [OpResult], []),
    deletePage: IDL.Func([IDL.Nat, IDL.Opt(IDL.Text)], [OpResult], []),
    getPages: IDL.Func([IDL.Opt(IDL.Text)], [IDL.Vec(Page)], ["query"]),
    createComponent: IDL.Func([IDL.Nat, IDL.Text, IDL.Text, IDL.Text, IDL.Nat, IDL.Opt(IDL.Text)], [IDL.Variant({ ok: Component, err: IDL.Text })], []),
    updateComponent: IDL.Func([IDL.Nat, IDL.Text, IDL.Text, IDL.Nat, IDL.Opt(IDL.Text)], [OpResult], []),
    deleteComponent: IDL.Func([IDL.Nat, IDL.Opt(IDL.Text)], [OpResult], []),
    getComponents: IDL.Func([IDL.Nat, IDL.Opt(IDL.Text)], [IDL.Vec(Component)], ["query"]),
    createRule: IDL.Func([IDL.Text, IDL.Bool, IDL.Text, IDL.Text, IDL.Text, IDL.Nat, IDL.Opt(IDL.Text)], [IDL.Variant({ ok: Rule, err: IDL.Text })], []),
    updateRule: IDL.Func([IDL.Nat, IDL.Bool, IDL.Text, IDL.Text, IDL.Text, IDL.Nat, IDL.Opt(IDL.Text)], [OpResult], []),
    deleteRule: IDL.Func([IDL.Nat, IDL.Opt(IDL.Text)], [OpResult], []),
    getRules: IDL.Func([IDL.Opt(IDL.Text)], [IDL.Vec(Rule)], ["query"]),
    getEnabledRules: IDL.Func([], [IDL.Vec(Rule)], ["query"]),
  });
};

const DEVICE_TYPES = {
  jishe: { icon: '🐔', label: '鸡舍' },
  shuibeng: { icon: '💧', label: '水泵' },
  juanlianmen: { icon: '🚪', label: '卷帘门' },
  shuangdeng: { icon: '💡', label: '双灯+水泵' },
  tempsensor: { icon: '🌡️', label: '温度传感器' },
  other: { icon: '📡', label: '其他' }
};

let authClient = null, backendActor = null, currentUser = null;
let sessionId = localStorage.getItem('sessionId') || null;
let allDevices = [], deviceId = '', cmdTopic = '', statusTopic = '';
let lampState = false, lamp2State = false, pumpState = false;
let lastHeartbeat = 0, mqttConnected = false, client = null, offlineCheckTimer = null, toastTimer = null;
let renamingDeviceId = null, selectedBindType = 'jishe', selectedRenameType = 'jishe', currentPageId = null;
let latestTemp = null;

const getDeviceName = id => localStorage.getItem('dn_' + id) || id;
const setDeviceName = (id, v) => v && v.trim() && localStorage.setItem('dn_' + id, v.trim());
const getDeviceType = id => localStorage.getItem('dt_' + id) || (id.startsWith('door_') ? 'tempsensor' : 'jishe');
const setDeviceType = (id, v) => localStorage.setItem('dt_' + id, v);
const getDeviceIcon = id => DEVICE_TYPES[getDeviceType(id)]?.icon || '📡';
function isDoorDevice(id) { return id && id.startsWith('door_'); }
function optSession() { return sessionId ? [sessionId] : []; }
function showToast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg; el.classList.add('show');
  if (toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 3000);
}
async function hashPassword(password, email) {
  const data = new TextEncoder().encode(password + email.toLowerCase());
  const hash = await crypto.subtle.digest('SHA-256', data);
  return Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2, '0')).join('');
}

