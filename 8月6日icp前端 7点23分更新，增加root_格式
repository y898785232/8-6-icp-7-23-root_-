function getAllBtns() {
  return ['btn-open', 'btn-lamp', 'btn-lamp2', 'btn-timer', 'btn-ota', 'btn-pump-on', 'btn-pump-off',
    'btn-curtain-open', 'btn-curtain-stop', 'btn-curtain-close', 'btn-on1', 'btn-off1', 'btn-on2', 'btn-refresh-temp']
    .filter(id => document.getElementById(id));
}
function setButtonsEnabled(en) {
  getAllBtns().forEach(id => { const b = document.getElementById(id); if (b) b.disabled = !en; });
}

function disconnectMQTT() {
  if (client) { try { client.end(true); } catch (_) {} client = null; }
  if (offlineCheckTimer) { clearInterval(offlineCheckTimer); offlineCheckTimer = null; }
  mqttConnected = false; lastHeartbeat = 0;
}

function initMQTT() {
  // door_ 设备用 door/ 主题，ESP_ 用原来的 home/esp8266/
  if (isDoorDevice(deviceId)) {
    cmdTopic = 'door/' + deviceId + '/cmd';
    statusTopic = 'door/' + deviceId + '/status';
  } else {
    cmdTopic = 'home/esp8266/cmd/' + deviceId;
    statusTopic = 'home/esp8266/status/' + deviceId;
  }
  disconnectMQTT();
  client = mqtt.connect(MQTT_HOST, {
    clientId: 'web_' + Math.random().toString(16).slice(2, 10),
    username: 'eps8266nn', password: 'yu155414',
    reconnectPeriod: 4000, connectTimeout: 8000, keepalive: 60
  });
  client.on('connect', () => {
    mqttConnected = true;
    setBanner('✅ 云端已连接', '#34c759');
    client.subscribe(statusTopic, { qos: 1 });
    if (isDoorDevice(deviceId)) {
      setTimeout(() => publish('STATUS'), 600);
    } else {
      setTimeout(() => publish('WHO_IS_ONLINE'), 600);
    }
    startOfflineWatch();
  });
  client.on('reconnect', () => setBanner('🔄 重连中...', '#ff9500'));
  client.on('close', () => {
    mqttConnected = false;
    setBanner('⚠️ 断开', '#ff3b30');
    setButtonsEnabled(false);
    setEl('dev-status', 'badge bg-offline', '已离线');
  });
  client.on('error', err => setBanner('错误: ' + err.message, '#ff3b30'));
  client.on('message', (topic, message) => {
    if (topic !== statusTopic) return;
    const msg = message.toString().trim();
    lastHeartbeat = Date.now();
    const ds = document.getElementById('dev-status');
    if (ds) { ds.className = 'badge bg-online'; ds.textContent = '在线'; }
    setButtonsEnabled(true);
    handleMessage(msg);
  });
}

function handleMessage(msg) {
  const type = getDeviceType(deviceId);

  // 尝试解析 JSON（温度传感器）
  if (msg.startsWith('{')) {
    try {
      const data = JSON.parse(msg);
      if (data.temperature !== undefined && data.temperature !== null) {
        latestTemp = Number(data.temperature);
        const el = document.getElementById('temp-display');
        if (el) el.textContent = latestTemp.toFixed(1) + ' °C';
        if (data.sensor_ok === false) {
          setEl('sensor-status', 'badge bg-warning', '异常');
        } else {
          setEl('sensor-status', 'badge bg-online', '正常');
        }
        if (data.online === false) {
          setEl('dev-status', 'badge bg-offline', '离线');
        }
        return;
      }
    } catch (e) { /* 不是合法 JSON，继续按文本处理 */ }
  }

  if (msg.startsWith('ONLINE_')) { showToast('🟢 设备上线'); return; }
  if (msg === 'OTA_START') {
    showToast('🚀 开始OTA');
    const b = document.getElementById('btn-ota');
    if (b) { b.textContent = '升级中...'; b.disabled = true; }
    return;
  }
  if (msg === 'OTA_OK') {
    const b = document.getElementById('btn-ota');
    if (b) { b.textContent = '触发OTA'; b.disabled = false; }
    showToast('✅ OTA成功'); return;
  }
  if (msg === 'OTA_FAIL') {
    const b = document.getElementById('btn-ota');
    if (b) { b.textContent = '触发OTA'; b.disabled = false; }
    showToast('❌ OTA失败'); return;
  }
  if (msg === 'OTA_NO_NEW') {
    const b = document.getElementById('btn-ota');
    if (b) b.disabled = false;
    showToast('ℹ️ 已是最新'); return;
  }

  if (type === 'jishe') {
    if (msg === 'ON1') { lampState = true; setEl('lamp-status', 'badge bg-online', '已开'); setBtn('btn-lamp', '关灯', 'btn btn-danger'); }
    else if (msg === 'OFF1') { lampState = false; setEl('lamp-status', 'badge bg-offline', '已关'); setBtn('btn-lamp', '开灯', 'btn btn-success'); }
    else if (msg === 'WATER_LOW_ALARM') { setEl('water-status', 'badge bg-warning', '缺水'); showToast('⚠️ 缺水'); }
    else if (msg === 'WATER_NORMAL') { setEl('water-status', 'badge bg-online', '正常'); }
    else if (msg === 'DARK') { setEl('light-status', 'badge bg-dark', '暗'); }
    else if (msg === 'BRIGHT') { setEl('light-status', 'badge bg-bright', '亮'); }
    else if (msg === 'LOCK_TRIGGERED') { showToast('🔒 门锁已触发'); }
    else if (msg.startsWith('TIMER_INFO_')) {
      const p = msg.split('_');
      if (p.length >= 5) {
        const tc = document.getElementById('timer-enable');
        const st = document.getElementById('start-time');
        const et = document.getElementById('end-time');
        if (tc) tc.checked = p[2] === '1';
        if (st) st.value = p[3];
        if (et) et.value = p[4];
        showToast('定时已同步');
      }
    }
  }
  if (type === 'shuibeng') {
    if (msg === 'PUMP_ON' || msg === 'ON1') { pumpState = true; setEl('pump-status', 'badge bg-online', '运行中'); }
    else if (msg === 'PUMP_OFF' || msg === 'OFF1') { pumpState = false; setEl('pump-status', 'badge bg-offline', '已停止'); }
  }
  if (type === 'juanlianmen') {
    if (msg === 'CURTAIN_OPEN') setEl('curtain-status', 'badge bg-online', '已开');
    else if (msg === 'CURTAIN_CLOSE') setEl('curtain-status', 'badge bg-offline', '已关');
    else if (msg === 'CURTAIN_STOP') setEl('curtain-status', 'badge bg-warning', '停止');
  }
  if (type === 'shuangdeng') {
    if (msg === 'ON1') { lampState = true; setEl('lamp-status', 'badge bg-online', '已开'); setBtn('btn-lamp', '关灯1', 'btn btn-danger'); }
    else if (msg === 'OFF1') { lampState = false; setEl('lamp-status', 'badge bg-offline', '已关'); setBtn('btn-lamp', '开灯1', 'btn btn-success'); }
    else if (msg === 'ON2') { lamp2State = true; setEl('lamp2-status', 'badge bg-online', '已开'); setBtn('btn-lamp2', '关灯2', 'btn btn-danger'); }
    else if (msg === 'OFF2') { lamp2State = false; setEl('lamp2-status', 'badge bg-offline', '已关'); setBtn('btn-lamp2', '开灯2', 'btn btn-success'); }
    else if (msg === 'PUMP_ON') { pumpState = true; setEl('pump-status', 'badge bg-online', '运行中'); }
    else if (msg === 'PUMP_OFF') { pumpState = false; setEl('pump-status', 'badge bg-offline', '已停止'); }
  }
}

function publish(cmd) {
  if (!client || !client.connected) { showToast('⚠️ 未连接'); return; }
  client.publish(cmdTopic, cmd, { qos: 1 });
}
function requestTemp() { publish('STATUS'); showToast('已请求温度'); }
function controlOpen() { if (!confirm('确定开门？')) return; publish('OPEN2'); }
function toggleLamp() { publish(lampState ? 'OFF1' : 'ON1'); }
function toggleLamp2() { publish(lamp2State ? 'OFF2' : 'ON2'); }
function pumpOn() { if (!confirm('确定开泵？')) return; publish('ON1'); }
function pumpOff() { if (!confirm('确定关泵？')) return; publish('OFF1'); }
function pumpOnMulti() { if (!confirm('确定开泵？')) return; publish('PUMP_ON'); }
function pumpOffMulti() { if (!confirm('确定关泵？')) return; publish('PUMP_OFF'); }
function curtainOpen() { publish('OPEN1'); }
function curtainStop() { publish('STOP1'); }
function curtainClose() { publish('CLOSE1'); }
function triggerOTA() { if (!confirm('确定OTA升级？请勿断电')) return; publish('DO_OTA_UPDATE'); }
function saveTimer() {
  const e = document.getElementById('timer-enable')?.checked ? 1 : 0;
  const s = document.getElementById('start-time')?.value;
  const d = document.getElementById('end-time')?.value;
  if (!s || !d) { showToast('请填写时间'); return; }
  publish('SET_TIMER_' + e + '_' + s + '_' + d);
  showToast('✅ 定时已发送');
}
function setEl(id, cls, text) { const el = document.getElementById(id); if (el) { el.className = cls; el.textContent = text; } }
function setBtn(id, text, cls) { const el = document.getElementById(id); if (el) { el.textContent = text; el.className = cls; } }
function setBanner(text, color) { const el = document.getElementById('mqtt-banner'); if (el) { el.textContent = text; el.style.color = color; } }
function startOfflineWatch() {
  if (offlineCheckTimer) clearInterval(offlineCheckTimer);
  offlineCheckTimer = setInterval(() => {
    if (lastHeartbeat && Date.now() - lastHeartbeat > OFFLINE_MS) {
      setEl('dev-status', 'badge bg-offline', '已离线');
      setButtonsEnabled(false);
    }
  }, 30000);
}

// ===== 页面 =====
async function loadPages() {
  try {
    const pages = await backendActor.getPages(optSession());
    const c = document.getElementById('page-list-container');
    c.innerHTML = '';
    document.getElementById('page-detail').classList.add('hidden');
    document.getElementById('page-create-card').classList.remove('hidden');
    if (!pages.length) {
      c.innerHTML = '<div style="color:#8e8e93;font-size:13px;margin-bottom:10px">暂无页面</div>';
      return;
    }
    pages.forEach(function (p) {
      const item = document.createElement('div');
      item.className = 'device-list-item';
      const info = document.createElement('div');
      info.className = 'device-info';
      const nameDiv = document.createElement('div');
      nameDiv.className = 'device-name';
      nameDiv.textContent = p.title;
      const idDiv = document.createElement('div');
      idDiv.className = 'device-id';
      idDiv.textContent = '设备: ' + p.deviceId + ' · ID:' + p.id;
      info.appendChild(nameDiv); info.appendChild(idDiv);
      const actions = document.createElement('div');
      actions.className = 'device-actions';
      const btnOpen = document.createElement('button');
      btnOpen.className = 'btn-ctrl'; btnOpen.textContent = '打开';
      btnOpen.onclick = function () { openPage(Number(p.id), p.title); };
      const btnDel = document.createElement('button');
      btnDel.className = 'btn-edit'; btnDel.textContent = '删除';
      btnDel.onclick = function () { deletePage(Number(p.id)); };
      actions.appendChild(btnOpen); actions.appendChild(btnDel);
      item.appendChild(info); item.appendChild(actions);
      c.appendChild(item);
    });
  } catch (e) { showToast('获取页面失败: ' + e.message); }
}

async function createPage() {
  const deviceIdVal = document.getElementById('new-page-device').value.trim();
  const title = document.getElementById('new-page-title').value.trim();
  if (!deviceIdVal || !title) return showToast('请填写设备ID和标题');
  try {
    const res = await backendActor.createPage(deviceIdVal, title, optSession());
    if (res.err) return showToast('❌ ' + res.err);
    showToast('✅ 页面已创建');
    document.getElementById('new-page-device').value = '';
    document.getElementById('new-page-title').value = '';
    loadPages();
  } catch (e) { showToast('❌ ' + e.message); }
}

async function deletePage(id) {
  if (!confirm('确定删除该页面及所有控件？')) return;
  try {
    const res = await backendActor.deletePage(BigInt(id), optSession());
    if (res.err) return showToast('❌ ' + res.err);
    showToast('✅ 已删除'); loadPages();
  } catch (e) { showToast('❌ ' + e.message); }
}

async function openPage(id, title) {
  currentPageId = id;
  document.getElementById('page-list-container').innerHTML = '';
  document.getElementById('page-create-card').classList.add('hidden');
  document.getElementById('page-detail').classList.remove('hidden');
  document.getElementById('cur-page-title').textContent = title;
  loadComponents(id);
}
function backPageList() {
  document.getElementById('page-detail').classList.add('hidden');
  loadPages();
}

async function loadComponents(pageId) {
  try {
    const list = await backendActor.getComponents(BigInt(pageId), optSession());
    const c = document.getElementById('component-list-container');
    c.innerHTML = '';
    if (!list.length) {
      c.innerHTML = '<div style="color:#8e8e93;font-size:13px;margin-bottom:10px">暂无控件</div>';
      return;
    }
    list.forEach(function (comp) {
      const item = document.createElement('div');
      item.className = 'device-list-item';
      const info = document.createElement('div');
      info.className = 'device-info';
      const nameDiv = document.createElement('div');
      nameDiv.className = 'device-name'; nameDiv.textContent = comp.title;
      const typeDiv = document.createElement('div');
      typeDiv.className = 'device-id'; typeDiv.textContent = comp.componentType + ' · sort:' + comp.sort;
      const cfgDiv = document.createElement('div');
      cfgDiv.className = 'device-id'; cfgDiv.textContent = comp.config;
      info.appendChild(nameDiv); info.appendChild(typeDiv); info.appendChild(cfgDiv);
      const btnDel = document.createElement('button');
      btnDel.className = 'btn-edit'; btnDel.textContent = '删除';
      btnDel.onclick = function () { deleteComponent(Number(comp.id)); };
      item.appendChild(info); item.appendChild(btnDel);
      c.appendChild(item);
    });
  } catch (e) { showToast('获取控件失败: ' + e.message); }
}

async function createComponent() {
  if (currentPageId == null) return showToast('请先打开页面');
  const type = document.getElementById('new-comp-type').value;
  const title = document.getElementById('new-comp-title').value.trim();
  const config = document.getElementById('new-comp-config').value.trim() || '{}';
  const sort = Number(document.getElementById('new-comp-sort').value || 1);
  if (!title) return showToast('请填写控件名称');
  try {
    const res = await backendActor.createComponent(BigInt(currentPageId), type, title, config, BigInt(sort), optSession());
    if (res.err) return showToast('❌ ' + res.err);
    showToast('✅ 控件已添加');
    document.getElementById('new-comp-title').value = '';
    document.getElementById('new-comp-config').value = '';
    loadComponents(currentPageId);
  } catch (e) { showToast('❌ ' + e.message); }
}

async function deleteComponent(id) {
  if (!confirm('确定删除该控件？')) return;
  try {
    const res = await backendActor.deleteComponent(BigInt(id), optSession());
    if (res.err) return showToast('❌ ' + res.err);
    showToast('✅ 已删除'); loadComponents(currentPageId);
  } catch (e) { showToast('❌ ' + e.message); }
}

// ===== 规则 =====
async function loadRules() {
  try {
    const rules = await backendActor.getRules(optSession());
    const c = document.getElementById('rule-list-container');
    c.innerHTML = '';
    if (!rules.length) {
      c.innerHTML = '<div style="color:#8e8e93;font-size:13px;margin-bottom:10px">暂无规则</div>';
      return;
    }
    rules.forEach(function (r) {
      const item = document.createElement('div');
      item.className = 'device-list-item';
      const info = document.createElement('div');
      info.className = 'device-info';
      const nameDiv = document.createElement('div');
      nameDiv.className = 'device-name';
      nameDiv.textContent = r.trigger + ' → ' + r.action;
      const sub1 = document.createElement('div');
      sub1.className = 'device-id';
      sub1.textContent = '设备:' + r.deviceId + ' · ' + (r.enable ? '启用' : '停用') + ' · 优先级:' + r.priority;
      const sub2 = document.createElement('div');
      sub2.className = 'device-id';
      sub2.textContent = '条件: ' + r.condition;
      info.appendChild(nameDiv); info.appendChild(sub1); info.appendChild(sub2);
      const btnDel = document.createElement('button');
      btnDel.className = 'btn-edit'; btnDel.textContent = '删除';
      btnDel.onclick = function () { deleteRule(Number(r.id)); };
      item.appendChild(info); item.appendChild(btnDel);
      c.appendChild(item);
    });
  } catch (e) { showToast('获取规则失败: ' + e.message); }
}

async function createRule() {
  const deviceIdVal = document.getElementById('new-rule-device').value.trim();
  const trigger = document.getElementById('new-rule-trigger').value.trim();
  const condition = document.getElementById('new-rule-condition').value.trim();
  const action = document.getElementById('new-rule-action').value.trim();
  const priority = Number(document.getElementById('new-rule-priority').value || 10);
  const enable = document.getElementById('new-rule-enable').checked;
  if (!deviceIdVal || !trigger || !condition || !action) return showToast('请填写完整规则');
  try {
    const res = await backendActor.createRule(deviceIdVal, enable, trigger, condition, action, BigInt(priority), optSession());
    if (res.err) return showToast('❌ ' + res.err);
    showToast('✅ 规则已创建'); loadRules();
  } catch (e) { showToast('❌ ' + e.message); }
}

async function deleteRule(id) {
  if (!confirm('确定删除该规则？')) return;
  try {
    const res = await backendActor.deleteRule(BigInt(id), optSession());
    if (res.err) return showToast('❌ ' + res.err);
    showToast('✅ 已删除'); loadRules();
  } catch (e) { showToast('❌ ' + e.message); }
}

