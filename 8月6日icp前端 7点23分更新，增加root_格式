async function init() {
  authClient = await AuthClient.create({ idleOptions: { disableIdle: true } });
  const identity = authClient.getIdentity();
  const agent = new HttpAgent({ identity, host: 'https://icp0.io' });
  backendActor = Actor.createActor(idlFactory, { agent, canisterId: BACKEND_CANISTER_ID });
  if (await authClient.isAuthenticated()) { await handleIILogin(true); }
  else if (sessionId) {
    try {
      const res = await backendActor.getMyProfile(optSession());
      if (res.ok) { currentUser = res.ok; showMain(); }
      else { localStorage.removeItem('sessionId'); sessionId = null; }
    } catch (e) { localStorage.removeItem('sessionId'); sessionId = null; }
  }
}

async function emailRegister() {
  const email = document.getElementById('reg-email').value.trim();
  const pwd = document.getElementById('reg-password').value;
  const pwd2 = document.getElementById('reg-password2').value;
  if (!email || !pwd) return showToast('请填写邮箱和密码');
  if (pwd.length < 6) return showToast('密码至少6位');
  if (pwd !== pwd2) return showToast('两次密码不一致');
  try {
    const hash = await hashPassword(pwd, email);
    const res = await backendActor.registerWithEmail(email, hash);
    if (res.err) return showToast('❌ ' + res.err);
    currentUser = res.ok.user;
    sessionId = (res.ok.sessionId && res.ok.sessionId[0]) || null;
    if (sessionId) localStorage.setItem('sessionId', sessionId);
    showToast('✅ 注册成功'); showMain();
  } catch (e) { showToast('❌ ' + e.message); }
}

async function emailLogin() {
  const email = document.getElementById('login-email').value.trim();
  const pwd = document.getElementById('login-password').value;
  if (!email || !pwd) return showToast('请填写邮箱和密码');
  try {
    const hash = await hashPassword(pwd, email);
    const res = await backendActor.loginWithEmail(email, hash);
    if (res.err) return showToast('❌ ' + res.err);
    currentUser = res.ok.user;
    sessionId = (res.ok.sessionId && res.ok.sessionId[0]) || null;
    if (sessionId) localStorage.setItem('sessionId', sessionId);
    showToast('✅ 登录成功'); showMain();
  } catch (e) { showToast('❌ ' + e.message); }
}

async function iiLogin() {
  try {
    await authClient.login({
      identityProvider: II_URL,
      maxTimeToLive: BigInt(30 * 24 * 60 * 60) * BigInt(1e9),
      onSuccess: async () => await handleIILogin(false),
      onError: err => showToast('❌ II登录失败: ' + (err || '未知错误'))
    });
  } catch (e) { showToast('❌ ' + e.message); }
}

async function handleIILogin(silent) {
  try {
    const identity = authClient.getIdentity();
    const agent = new HttpAgent({ identity, host: 'https://icp0.io' });
    backendActor = Actor.createActor(idlFactory, { agent, canisterId: BACKEND_CANISTER_ID });
    const res = await backendActor.getOrCreateUserByII();
    if (res.err) { if (!silent) showToast('❌ ' + res.err); return; }
    currentUser = res.ok.user; sessionId = null; localStorage.removeItem('sessionId');
    if (!silent) showToast('✅ II登录成功');
    showMain();
  } catch (e) { if (!silent) showToast('❌ ' + e.message); }
}

async function logout() {
  if (await authClient.isAuthenticated()) await authClient.logout();
  currentUser = null; sessionId = null; localStorage.removeItem('sessionId'); location.reload();
}

