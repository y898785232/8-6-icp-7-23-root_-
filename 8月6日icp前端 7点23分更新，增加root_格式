async function bindDevice() {
  let id = document.getElementById('modal-device-id').value.trim();
  const name = document.getElementById('modal-device-name').value.trim();
  if (!id) return showToast('请输入设备ID');
  // door_ 保持小写风格，ESP_ 转大写
  if (id.toLowerCase().startsWith('door_')) {
    id = 'door_' + id.substring(5);
  } else {
    id = id.toUpperCase();
  }
  if (!id.startsWith('ESP_') && !id.startsWith('door_')) {
    return showToast('设备ID应以 ESP_ 或 door_ 开头');
  }
  try {
    const res = await backendActor.bindDevice(id, optSession());
    if (res.err) return showToast('❌ ' + res.err);
    setDeviceName(id, name || id);
    // door_ 默认温度传感器类型
    const type = selectedBindType === 'jishe' && id.startsWith('door_') ? 'tempsensor' : selectedBindType;
    setDeviceType(id, type);
    document.getElementById('modal-overlay').style.display = 'none';
    showToast('✅ 绑定成功');
    loadDevices();
  } catch (e) { showToast('❌ ' + e.message); }
}

