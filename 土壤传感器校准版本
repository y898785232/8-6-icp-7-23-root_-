/*
 * ESP8266 D1 Mini 土壤湿度传感器 - door_ 协议（串口校准版）
 * 
 * 校准方法（只需一次）：
 *   1. 上传代码，打开串口监视器（波特率 115200）
 *   2. 传感器暴露在干燥空气中，串口发送: CAL_DRY
 *   3. 传感器插入水杯/湿土中，串口发送: CAL_WET
 *   4. 校准值自动保存到 Flash，重启后仍然有效
 *   5. 发送 CAL_SHOW 可查看当前校准值
 */

#include <ESP8266WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WiFiManager.h>
#include <SoftwareSerial.h>
#include <ArduinoJson.h>
#include <EEPROM.h>

// ========== 引脚定义 ==========
#define SOIL_PIN        A0
#define LORA_RX         D2
#define LORA_TX         D1
#define LORA_M0         D7
#define LORA_M1         D6

// ========== EEPROM 地址 ==========
#define ADDR_DRY        0
#define ADDR_WET        4
#define ADDR_FLAG       8
#define CAL_FLAG_MAGIC  0xABCD

SoftwareSerial LoRaSerial(LORA_RX, LORA_TX);

const char* mqtt_server = "b7fea2bf.ala.asia-southeast1.emqxsl.com";
const uint16_t mqtt_port = 8883;
const char* mqtt_user = "eps8266nn";
const char* mqtt_pass = "yu155414";

WiFiClientSecure secureClient;
PubSubClient mqttClient(secureClient);

String deviceId;
String topicCmd;
String topicStatus;

const unsigned long SAMPLE_INTERVAL = 60000UL;
unsigned long lastSample = 0;

float latestMoisture = 0.0;
int latestRawAdc = 0;
bool sensorOk = false;

// 校准值（从 EEPROM 加载或默认）
int soilDry = 850;
int soilWet = 50;

// ========== 看门狗 ==========
void feedWatchdog() {
  #ifdef ESP8266
    ESP.wdtFeed();
  #endif
}

// ========== LoRa 初始化 ==========
void setLoRaMode() {
  pinMode(LORA_M0, OUTPUT);
  pinMode(LORA_M1, OUTPUT);
  digitalWrite(LORA_M0, LOW);
  digitalWrite(LORA_M1, LOW);
  delay(100);
}

// ========== 生成设备 ID ==========
String makeDeviceId() {
  return "door_" + String(ESP.getChipId(), HEX);
}

// ========== EEPROM 校准 ==========
void loadCalibration() {
  EEPROM.begin(512);
  int flag;
  EEPROM.get(ADDR_FLAG, flag);
  if (flag == CAL_FLAG_MAGIC) {
    EEPROM.get(ADDR_DRY, soilDry);
    EEPROM.get(ADDR_WET, soilWet);
    Serial.printf("✅ 已加载校准值: 干燥=%d, 湿润=%d\n", soilDry, soilWet);
  } else {
    Serial.println("⚠️ 未校准，使用默认值。请发送 CAL_DRY 和 CAL_WET");
  }
}

void saveCalibration() {
  EEPROM.put(ADDR_DRY, soilDry);
  EEPROM.put(ADDR_WET, soilWet);
  int flag = CAL_FLAG_MAGIC;
  EEPROM.put(ADDR_FLAG, flag);
  EEPROM.commit();
  Serial.printf("💾 校准值已保存: 干燥=%d, 湿润=%d\n", soilDry, soilWet);
}

// ========== 读取土壤湿度 ==========
void readSoilSensor() {
  long sum = 0;
  for (int i = 0; i < 5; i++) {
    sum += analogRead(SOIL_PIN);
    delay(5);
  }
  int raw = sum / 5;
  latestRawAdc = raw;

  sensorOk = (raw > 0 && raw < 1024);

  if (sensorOk) {
    // 确保 dry > wet，如果用户校准反了自动交换
    int d = max(soilDry, soilWet);
    int w = min(soilDry, soilWet);
    float pct = map(raw, d, w, 0, 100);
    if (pct < 0) pct = 0;
    if (pct > 100) pct = 100;
    latestMoisture = pct;
    Serial.printf("土壤湿度 raw=%d  →  %.1f%%\n", raw, pct);
  } else {
    Serial.printf("土壤湿度读取异常 raw=%d\n", raw);
  }
}

// ========== 数据上报 ==========
void publishStatus(bool online) {
  if (!mqttClient.connected()) return;
  StaticJsonDocument<256> doc;
  doc["online"] = online;
  doc["sensor_ok"] = sensorOk;
  doc["unit"] = "%";
  doc["raw_adc"] = latestRawAdc;
  doc["dry_cal"] = soilDry;
  doc["wet_cal"] = soilWet;
  if (sensorOk) doc["moisture"] = latestMoisture;
  else doc["moisture"] = nullptr;
  char payload[350];
  serializeJson(doc, payload);
  mqttClient.publish(topicStatus.c_str(), payload, true);
  Serial.printf("→ MQTT 上报: %s\n", payload);
}

void sendLoRaData() {
  StaticJsonDocument<256> doc;
  doc["id"] = deviceId;
  doc["ok"] = sensorOk;
  doc["ts"] = millis() / 1000;
  doc["raw"] = latestRawAdc;
  if (sensorOk) doc["moisture"] = latestMoisture;
  else doc["moisture"] = nullptr;
  char json[250];
  serializeJson(doc, json);
  LoRaSerial.println(json);
  Serial.printf("→ LoRa 发送: %s\n", json);
}

// ========== MQTT 回调 ==========
void mqttCallback(char* topic, byte* payload, unsigned int length) {
  char buf[64];
  if (length >= sizeof(buf)) length = sizeof(buf) - 1;
  memcpy(buf, payload, length);
  buf[length] = '\0';
  String command = String(buf);
  command.trim();

  Serial.printf("← MQTT 命令: [%s] %s\n", topic, command.c_str());

  if (command == "STATUS") {
    readSoilSensor();
    sendLoRaData();
    publishStatus(true);
  }
}

// ========== MQTT 重连 ==========
void reconnectMQTT() {
  if (mqttClient.connected()) return;

  Serial.println("连接 MQTT...");
  secureClient.stop();
  delay(100);
  secureClient.setInsecure();
  secureClient.setTimeout(10);
  mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setCallback(mqttCallback);

  Serial.printf("clientId: %s\n", deviceId.c_str());

  if (mqttClient.connect(deviceId.c_str(), mqtt_user, mqtt_pass)) {
    Serial.println("MQTT 连接成功");
    mqttClient.subscribe(topicCmd.c_str());
    publishStatus(true);
  } else {
    Serial.printf("MQTT 连接失败, rc=%d\n", mqttClient.state());
  }
}

// ========== WiFi 主动重连 ==========
void checkWiFi() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi 断开，尝试重连...");
    WiFi.reconnect();
    unsigned long start = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - start < 10000) {
      delay(100);
      feedWatchdog();
    }
    if (WiFi.status() == WL_CONNECTED) {
      Serial.println("WiFi 重连成功");
    }
  }
}

// ========== 串口命令处理（校准用）==========
void handleSerialCommand() {
  if (!Serial.available()) return;
  String cmd = Serial.readStringUntil('\n');
  cmd.trim();
  cmd.toUpperCase();

  if (cmd == "CAL_DRY") {
    readSoilSensor();
    soilDry = latestRawAdc;
    saveCalibration();
    Serial.printf("🌵 干燥校准完成: %d\n", soilDry);
  }
  elseDry);
  }
  else if (cmd == "CAL_WET") {
    readSoilSensor();
    soilWet = latestRawAdc;
    saveCalibration();
    Serial.printf("💧 湿润校准完成: %d\n", soilWet);
  }
  else if (cmd == "CAL_SHOW") {
    Serial.printf("📊 当前校准: 干燥=%d, 湿润=%d\n", soilDry, soilWet);
  }
  else if (cmd == "CAL_RESET") {
    EEPROM.put(ADDR_FLAG, 0);
    EEPROM.commit();
    Serial.println("🔄 校准已清除，重启中...");
    delay(500);
    ESP.restart();
  }
}

void setup() {
  Serial.begin(115200);
  delay(2000);

  Serial.println();
  Serial.println("==============================");
  Serial.println("ESP8266 土壤湿度传感器启动");
  Serial.println("==============================");

  loadCalibration();

  pinMode(SOIL_PIN, INPUT);

  LoRaSerial.begin(9600);
  Serial.println("LoRaSerial OK");

  setLoRaMode();
  Serial.println("LoRa 模式 OK");

  deviceId = makeDeviceId();
  topicCmd = "door/" + deviceId + "/cmd";
  topicStatus = "door/" + deviceId + "/status";
  Serial.println("设备ID: " + deviceId);

  // WiFi 配网
  WiFi.disconnect(true);
  delay(100);

  WiFiManager wifiManager;
  wifiManager.setConfigPortalTimeout(300);
  bool wifiOk = wifiManager.autoConnect("SOIL_SENSOR_ESP8266", "12345678");
  if (!wifiOk) {
    Serial.println("配网失败，自动重启");
    ESP.restart();
  }

  Serial.println("WiFi 配网成功，IP: " + WiFi.localIP().toString());

  WiFi.setSleepMode(WIFI_NONE_SLEEP);
  WiFi.setAutoReconnect(true);

  readSoilSensor();
  lastSample = millis();

  reconnectMQTT();
  Serial.println("MQTT init OK");

  sendLoRaData();
  publishStatus(true);

  Serial.println("启动完成！");
  Serial.println("可用串口命令: CAL_DRY / CAL_WET / CAL_SHOW / CAL_RESET");
}

void loop() {
  feedWatchdog();
  handleSerialCommand();  // 处理串口校准命令
  checkWiFi();

  if (WiFi.status() == WL_CONNECTED) {
    if (!mqttClient.connected()) {
      reconnectMQTT();
    }
    mqttClient.loop();
  }

  unsigned long now = millis();

  // 定时采样
  if (now - lastSample >= SAMPLE_INTERVAL) {
    lastSample = now;
    readSoilSensor();
    sendLoRaData();
    if (mqttClient.connected()) publishStatus(true);
  }

  // LoRa 命令处理
  if (LoRaSerial.available()) {
    String cmd = LoRaSerial.readStringUntil('\n');
    cmd.trim();
    if (cmd.indexOf("STATUS") != -1) {
      readSoilSensor();
      sendLoRaData();
    }
  }

  delay(10);
}
